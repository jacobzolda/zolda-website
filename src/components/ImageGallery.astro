---
interface Props {
  images: { src: string; alt: string }[];
}

const { images = [] } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2">
  {images.map((image) => (
    <img class="h-full w-full rounded-lg border border-zinc-800 object-cover" src={image.src} alt={image.alt} loading="lazy" />
  ))}
</div>
