---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a href={href} class="block rounded-lg border border-zinc-800 p-5 transition hover:border-zinc-600 hover:bg-zinc-900">
  <h3 class="text-lg font-semibold">{title}</h3>
  <p class="mt-2 text-sm text-zinc-300">{description}</p>
</a>
