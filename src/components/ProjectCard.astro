---
interface Props {
  title: string;
  description: string;
  href: string;
  section?: string;
  date?: Date;
  dateLabel?: string;
}

const { title, description, href, section, date, dateLabel } = Astro.props;
---

<a href={href} class="block rounded-lg border border-zinc-800 p-5 transition hover:border-zinc-600 hover:bg-zinc-900">
  <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-wide text-zinc-400">
    {section && <span>{section.replace("-", " ")}</span>}
    {dateLabel
      ? <span>{dateLabel}</span>
      : date && <span>{date.toLocaleDateString("en-US", { year: "numeric", month: "short", timeZone: "UTC" })}</span>}
  </div>
  <h3 class="text-lg font-semibold">{title}</h3>
  <p class="mt-2 text-sm text-zinc-300">{description}</p>
</a>
