---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  hook?: string;
}

const { title, hook = "Project case study" } = Astro.props;
---

<BaseLayout title={title} description={hook}>
  <article class="space-y-6">
    <header class="space-y-2 border-b border-zinc-800 pb-6">
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{title}</h1>
      <p class="text-zinc-300">{hook}</p>
    </header>
    <slot />
  </article>
</BaseLayout>
