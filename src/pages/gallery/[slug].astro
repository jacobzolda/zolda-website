---
import { getCollection, render } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import TagPill from "../../components/TagPill.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const links = Object.entries(project.data.links).filter(([, url]) => Boolean(url));
const linkLabels: Record<string, string> = {
  github: "GitHub",
  itch: "itch.io",
  pdf: "PDF",
  writeup: "Writeup",
  press: "Press"
};
---

<ProjectLayout title={project.data.title} hook={project.data.description}>
  <section class="space-y-4">
    <p class="text-sm uppercase tracking-[0.2em] text-zinc-400">
      {project.data.section.replace("-", " ")} | {
        project.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long" })
      }
    </p>

    {project.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {project.data.tags.map((tag) => <TagPill label={tag} />)}
      </div>
    )}
  </section>

  {project.data.media.youtube && (
    <VideoEmbed src={project.data.media.youtube} title={`${project.data.title} YouTube`} />
  )}

  {project.data.media.vimeo && (
    <VideoEmbed src={project.data.media.vimeo} title={`${project.data.title} Vimeo`} />
  )}

  {links.length > 0 && (
    <section class="space-y-2">
      <h2 class="text-xl font-semibold">Links</h2>
      <ul class="flex flex-wrap gap-3">
        {links.map(([label, url]) => (
          <li>
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-300 underline decoration-zinc-600 underline-offset-4 transition hover:text-white"
            >
              {linkLabels[label] ?? label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <article class="prose prose-invert max-w-none">
    <Content />
  </article>
</ProjectLayout>


