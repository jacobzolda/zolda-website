---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.section === "hardware")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Hardware | Portfolio">
  <h1 class="text-3xl font-bold tracking-tight">Hardware</h1>
  <p class="mt-3 text-zinc-300">Hardware repairs, modifications, and refurbishment.</p>
  <section class="mt-8 grid gap-4 sm:grid-cols-2">
    {projects.map((project) => (
      <ProjectCard
        title={project.data.title}
        description={project.data.description}
        href={`/gallery/${project.slug}`}
        section={project.data.section}
        date={project.data.date}
        dateLabel={project.data.dateLabel}
      />
    ))}
  </section>
</BaseLayout>
