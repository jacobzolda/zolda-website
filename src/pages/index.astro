---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const flagship = allProjects.find((p) => p.slug === "vox-ex-machina");
const flagshipImage =
  flagship?.data.media.images.find((img) => img.src.endsWith("VEM_performance2.jpg")) ??
  flagship?.data.media.images[0];
const otherFeatured = allProjects.filter((p) => p.slug !== "vox-ex-machina").slice(0, 4);

const toolbox = [
  "Python",
  "C / C# / C++",
  "CUDA",
  "HDL",
  "Arduino",
  "ESP32",
  "FPGA",
  "Unity",
  "Unreal Engine",
  "Max/MSP",
  "DaVinci Resolve",
  "Vicon/Shogun"
];
---

<BaseLayout
  title="Jacob Zolda | Computer Engineer, Creative Technology"
  description="Computer engineer building embedded and real-time systems where technology meets creative media."
>
  <section class="space-y-5">
    <p class="text-sm uppercase tracking-[0.2em] text-zinc-400">Jacob Zolda</p>
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
      Computer Engineer | Creative Technology
    </h1>
    <p class="max-w-2xl text-zinc-300">
      I build embedded and real-time systems where technology meets creative media. My work spans
      live-performance robotics, wearable signal-processing platforms, and cinematic production.
    </p>
    <div class="flex flex-wrap gap-3 pt-2">
      <a
        href="/resume"
        class="inline-flex items-center rounded-md bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-950 transition hover:bg-white"
      >
        Resume
      </a>
      <a
        href="/gallery"
        class="inline-flex items-center rounded-md border border-zinc-700 px-4 py-2 text-sm font-medium text-zinc-100 transition hover:border-zinc-500 hover:bg-zinc-900"
      >
        View All Work
      </a>
      <a
        href="mailto:jakezolda@gmail.com"
        class="inline-flex items-center rounded-md border border-zinc-700 px-4 py-2 text-sm font-medium text-zinc-100 transition hover:border-zinc-500 hover:bg-zinc-900"
      >
        Contact
      </a>
    </div>
  </section>

  {flagship && (
    <section class="mt-14 space-y-4">
      <p class="text-sm uppercase tracking-[0.2em] text-zinc-400">Flagship Project</p>
      <a
        href="/vox-ex-machina"
        class="group block overflow-hidden rounded-xl border border-zinc-700 bg-zinc-900/40 transition hover:border-zinc-500"
      >
        <img
          src={flagshipImage?.src}
          alt={flagshipImage?.alt ?? flagship.data.title}
          class="h-64 w-full object-cover sm:h-80"
          loading="lazy"
        />
        <div class="space-y-2 p-6">
          <h2 class="text-2xl font-bold tracking-tight group-hover:underline">
            {flagship.data.title}
          </h2>
          <p class="max-w-2xl text-zinc-300">{flagship.data.description}</p>
        </div>
      </a>
    </section>
  )}

  <section class="mt-14 space-y-4">
    <p class="text-sm uppercase tracking-[0.2em] text-zinc-400">Featured Work</p>
    <div class="grid gap-4 sm:grid-cols-2">
      {otherFeatured.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          href={`/gallery/${project.slug}`}
          section={project.data.section}
          date={project.data.date}
          dateLabel={project.data.dateLabel}
        />
      ))}
    </div>
  </section>

  <section class="mt-14 space-y-4 border-t border-zinc-800 pt-10">
    <p class="text-sm uppercase tracking-[0.2em] text-zinc-400">Toolbox</p>
    <div class="flex flex-wrap gap-2">
      {toolbox.map((tool) => (
        <span class="inline-flex rounded-full border border-zinc-700 px-3 py-1 text-xs text-zinc-200">
          {tool}
        </span>
      ))}
    </div>
  </section>
</BaseLayout>
