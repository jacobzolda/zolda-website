---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home | Jake Portfolio" description="Creative technologist portfolio">
  <section class="space-y-4">
    <p class="text-sm uppercase tracking-[0.2em] text-zinc-400">Personal Portfolio</p>
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">Creative Technologist</h1>
    <p class="max-w-2xl text-zinc-300">
      I build projects across film, game design, mocap, and hardware. This site is structured as a curated archive
      of my process and outcomes.
    </p>
  </section>
</BaseLayout>
